<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created with JFLAP 7.1.--><structure>
	<type>pda</type>
	<automaton>
		<!--Sub-diagrama 1 para Exposicion: Colores Fijos (q0 a q4), PUSH al cambiar/apagar y POP al reencender-->
		<state id="0" name="q0">
			<x>140.0</x>
			<y>300.0</y>
			<label>Apagado</label>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>450.0</x>
			<y>100.0</y>
			<label>Blanco (Pila: 1)</label>
		</state>
		<state id="2" name="q2">
			<x>800.0</x>
			<y>100.0</y>
			<label>Rojo (Pila: 2)</label>
		</state>
		<state id="3" name="q3">
			<x>800.0</x>
			<y>500.0</y>
			<label>Verde (Pila: 3)</label>
		</state>
		<state id="4" name="q4">
			<x>450.0</x>
			<y>500.0</y>
			<label>Azul (Pila: 4)</label>
		</state>
		<!--1. Arranque en frio desde q0 con tope Z-->
		<transition>
			<from>0</from>
			<to>1</to>
			<read>e</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<!--2. Reencendido con memoria desde q0 (hace POP del estado guardado al apagar)-->
		<transition>
			<from>0</from>
			<to>1</to>
			<read>e</read>
			<pop>1</pop>
			<push/>
		</transition>
		<transition>
			<from>0</from>
			<to>2</to>
			<read>e</read>
			<pop>2</pop>
			<push/>
		</transition>
		<transition>
			<from>0</from>
			<to>3</to>
			<read>e</read>
			<pop>3</pop>
			<push/>
		</transition>
		<transition>
			<from>0</from>
			<to>4</to>
			<read>e</read>
			<pop>4</pop>
			<push/>
		</transition>
		<!--3. Apagado desde colores activos (hace PUSH del estado actual antes de ir a q0)-->
		<transition>
			<from>1</from>
			<to>0</to>
			<read>a</read>
			<pop/>
			<push>1</push>
		</transition>
		<transition>
			<from>2</from>
			<to>0</to>
			<read>a</read>
			<pop/>
			<push>2</push>
		</transition>
		<transition>
			<from>3</from>
			<to>0</to>
			<read>a</read>
			<pop/>
			<push>3</push>
		</transition>
		<transition>
			<from>4</from>
			<to>0</to>
			<read>a</read>
			<pop/>
			<push>4</push>
		</transition>
		<!--4. Cambios entre colores fijos (hacen PUSH del color de origen)-->
		<transition>
			<from>1</from>
			<to>2</to>
			<read>r</read>
			<pop/>
			<push>1</push>
		</transition>
		<transition>
			<from>1</from>
			<to>3</to>
			<read>v</read>
			<pop/>
			<push>1</push>
		</transition>
		<transition>
			<from>1</from>
			<to>4</to>
			<read>z</read>
			<pop/>
			<push>1</push>
		</transition>
		<transition>
			<from>2</from>
			<to>1</to>
			<read>b</read>
			<pop/>
			<push>2</push>
		</transition>
		<transition>
			<from>2</from>
			<to>3</to>
			<read>v</read>
			<pop/>
			<push>2</push>
		</transition>
		<transition>
			<from>2</from>
			<to>4</to>
			<read>z</read>
			<pop/>
			<push>2</push>
		</transition>
		<transition>
			<from>3</from>
			<to>1</to>
			<read>b</read>
			<pop/>
			<push>3</push>
		</transition>
		<transition>
			<from>3</from>
			<to>2</to>
			<read>r</read>
			<pop/>
			<push>3</push>
		</transition>
		<transition>
			<from>3</from>
			<to>4</to>
			<read>z</read>
			<pop/>
			<push>3</push>
		</transition>
		<transition>
			<from>4</from>
			<to>1</to>
			<read>b</read>
			<pop/>
			<push>4</push>
		</transition>
		<transition>
			<from>4</from>
			<to>2</to>
			<read>r</read>
			<pop/>
			<push>4</push>
		</transition>
		<transition>
			<from>4</from>
			<to>3</to>
			<read>v</read>
			<pop/>
			<push>4</push>
		</transition>
	</automaton>
</structure>